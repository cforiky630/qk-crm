<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.qk</groupId>
        <artifactId>qk-parent</artifactId>
        <version>1.1.12</version>
    </parent>

    <artifactId>qk-common</artifactId>
    <!-- 独立版本：与父 POM 的 qk.common.version 保持一致 -->
    <version>1.0.1</version>
    <name>qk-common</name>
    <description>通用能力：统一响应、分页、业务异常、JWT、OSS 客户端、当前用户上下文</description>

    <dependencies>
        <!-- Spring 基础，提供 @Configuration、@Bean、@Component 等 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- 阿里云 OSS SDK V2：上传图片 -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>alibabacloud-oss-v2</artifactId>
        </dependency>

        <!-- Hutool：JWT 签发与校验 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>


        <!-- Result 用到 @JsonInclude。显式声明而不是靠 OSS SDK 传递带入：
             传递依赖一旦调整，注解就会突然找不到，编译报错但原因不直观 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

</project>
