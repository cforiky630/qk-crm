<component name="ProjectRunConfigurationManager">
  <!--
    共享运行配置：把工作目录固定为项目根目录。
    这样 ./logs 和 ./config/application-local.yml 两个相对路径都能稳定命中项目根，
    不会因为 IDE 默认使用模块目录而多出一个 qk-management/logs。
  -->
  <configuration default="false" name="QkApplication" type="SpringBootApplicationConfigurationType" factoryName="Spring Boot">
    <option name="SPRING_BOOT_MAIN_CLASS" value="com.qk.QkApplication" />
    <module name="qk-management" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
