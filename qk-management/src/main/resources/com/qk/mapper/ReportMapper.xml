<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qk.mapper.ReportMapper">

    <!--
      首页概览：SQL 只做「按状态分组计数」，不再把 1~5 这些状态码抄进 SQL。
      「哪个状态落到概览的哪个字段」由 ReportServiceImpl 按 ClueStatus / BusinessStatus 组装，
      因此新增状态时只需要改枚举与组装逻辑，SQL 不会与枚举脱节。
      总数 = 各分组之和（status 列 NOT NULL，每行必属于某个分组），与改造前的 COUNT(*) 等价。
    -->
    <select id="countClueByStatus" resultType="com.qk.entity.vo.StatusCountVO">
        SELECT status, COUNT(*) AS total
        FROM clue
        GROUP BY status
    </select>

    <select id="countBusinessByStatus" resultType="com.qk.entity.vo.StatusCountVO">
        SELECT status, COUNT(*) AS total
        FROM business
        GROUP BY status
    </select>

</mapper>
