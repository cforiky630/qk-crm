<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qk.mapper.ClueMapper">

    <!-- 线索列表视图：附带归属人姓名 -->
    <sql id="listSelect">
        SELECT c.*, u.name AS assign_name
        FROM clue c
        LEFT JOIN `user` u ON c.user_id = u.id AND u.is_deleted = 0
    </sql>

    <!-- 线索池视图：附带活动名称 -->
    <sql id="poolSelect">
        SELECT c.*, a.name AS activity_name
        FROM clue c
        LEFT JOIN activity a ON c.activity_id = a.id AND a.is_deleted = 0
    </sql>

    <select id="listClues" resultType="com.qk.entity.vo.ClueVO">
        <include refid="listSelect"/>
        <where>
            <!--
              默认视图只展示未关闭的线索：4 伪线索（在线索池里重新分配）、
              5 转为商机（由商机模块接管），对应 ClueStatus.CLOSED_CODES。
              但前端的状态下拉里包含这两个状态，显式筛选时按用户的选择走，
              否则选了「伪线索」永远只能得到空列表。
            -->
            <choose>
                <when test="clueQueryDto.status != null">
                    AND c.status = #{clueQueryDto.status}
                </when>
                <otherwise>
                    AND c.status NOT IN (4, 5)
                </otherwise>
            </choose>
            <if test="clueQueryDto.clueId != null">
                AND c.id = #{clueQueryDto.clueId}
            </if>
            <if test="clueQueryDto.phone != null and clueQueryDto.phone != ''">
                AND c.phone LIKE CONCAT('%', #{clueQueryDto.phone}, '%')
            </if>
            <if test="clueQueryDto.channel != null">
                AND c.channel = #{clueQueryDto.channel}
            </if>
            <if test="clueQueryDto.assignName != null and clueQueryDto.assignName != ''">
                AND u.name LIKE CONCAT('%', #{clueQueryDto.assignName}, '%')
            </if>
        </where>
        ORDER BY c.update_time DESC, c.id DESC
    </select>

    <!-- 线索详情：跟进记录由 ClueTrackRecordMapper 单独查询后在 Service 组装 -->
    <select id="getClueById" resultType="com.qk.entity.vo.ClueVO">
        <include refid="listSelect"/>
        WHERE c.id = #{id}
    </select>

    <!--
      线索池：只查伪线索（status = 4，对应 ClueStatus.FALSE_CLUE），用于重新分配。
      与公海池（只查 status = 4 的商机）保持同一种口径：池子只放「被判定为无效/被回收」的数据，
      待分配、待跟进、跟进中的线索留在线索列表里。
    -->
    <select id="getPoolClues" resultType="com.qk.entity.vo.ClueVO">
        <include refid="poolSelect"/>
        <where>
            AND c.status = 4
            <if test="cluePoolDto.clueId != null">
                AND c.id = #{cluePoolDto.clueId}
            </if>
            <if test="cluePoolDto.phone != null and cluePoolDto.phone != ''">
                AND c.phone LIKE CONCAT('%', #{cluePoolDto.phone}, '%')
            </if>
            <if test="cluePoolDto.channel != null">
                AND c.channel = #{cluePoolDto.channel}
            </if>
        </where>
        ORDER BY c.update_time DESC, c.id DESC
    </select>

</mapper>
